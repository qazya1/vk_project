                 <property name="font">
                  <font>
                   <family>Roboto Light</family>
                   <pointsize>10</pointsize>
                  </font>
                 </property>
                 <property name="styleSheet">
                  <string notr="true">QTableWidget {
    font-family: &quot;Roboto Light&quot;;
    background-color: white;
    outline: 0;
    border: none;
    border-left: 1px solid #62560E;
selection-background-color: transparent;
        selection-color: #62560E;
}

QHeaderView {
    font-size: 21px;
}

QHeaderView::section {
    font-family: &quot;Roboto Light&quot;;
    font-size: 21px;
    background-color: white;
    color: #62560E;
    border: 1px solid #62560E;
    border-top: 1px solid #62560E;
    border-left: none;
    border-bottom: 1px solid #62560E;
    padding: 10px;
}

QTableWidget::item {
    font-size: 20px;
    border: none;
    border-bottom: 1px solid #62560E;
    border-right: 1px solid #62560E;
    padding: 8px;
qproperty-iconSize: 54px;
}

/* Первая строка */
QTableWidget::item[row=&quot;0&quot;] {
    border-bottom: 2px solid #62560E;
}

/* Первый столбец */
QTableWidget::item:first {
    border-left: 1px solid #62560E;
}

/* Угловые ячейки */
QTableWidget::item:first:first {
    border-top: 1px solid #62560E;
}

/* Ссылки */
/*QTableWidget::item {
    color: #62560E;
}*/</string>
